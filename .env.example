# Required: get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change backend port (must match vite.config.ts proxy)
PORT=3001

# Optional: tweak which Claude models the agent uses
# Haiku is used for the fast/cheap boundary detector
BOUNDARY_MODEL=claude-haiku-4-5-20251001
# Sonnet is used for the polisher (higher quality)
POLISH_MODEL=claude-sonnet-4-6

# Optional: pricing in USD per 1 MILLION tokens — used to estimate cost in the UI.
# Authoritative numbers live at https://console.anthropic.com/settings/usage
HAIKU_INPUT_PRICE=1.0
HAIKU_OUTPUT_PRICE=5.0
SONNET_INPUT_PRICE=3.0
SONNET_OUTPUT_PRICE=15.0
